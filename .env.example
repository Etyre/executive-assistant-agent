# Copy to data/.env (or export). Never commit.
ANTHROPIC_API_KEY=sk-ant-...
TOGGL_API_TOKEN=...                 # Toggl -> Profile -> API token
AGENT_API_TOKEN=                    # optional: the Project Tracker's agent-API token (Settings -> Assistant agent)
CALENDAR_ICS_URLS=                  # Google Calendar 'Secret address in iCal format', comma-separated; same as the tracker's [calendar] ics_urls
CALENDAR_WRITE_URL=                 # /exec URL of the Apps Script in deploy/calendar_script (calendar write access); empty = read-only
CALENDAR_WRITE_TOKEN=               # shared secret; the same value goes in the script's CALENDAR_TOKEN property
READ_SHEETS=                        # Google Sheets the agent may read: "name=/exec URL" per sheet, comma-separated (deploy/sheet_reader_script, one bound copy per sheet)
READ_SHEETS_TOKEN=                  # shared secret; the same value goes in each script's SHEET_TOKEN property
EXERCISE_EXPORT_URL=https://script.google.com/macros/s/.../exec   # same as Project Tracker's "Exercise log script URL"
OTTER_EMAIL=                        # Otter.ai login, read-only; a Google-sign-in account needs an Otter password set first
OTTER_PASSWORD=
APNS_KEY_PATH=AuthKey_XXXXXXXXXX.p8    # Apple push key (.p8) for the iPhone/Mac apps; relative = inside data/
APNS_KEY_ID=XXXXXXXXXX               # developer.apple.com -> Keys -> the key's ID
APNS_TEAM_ID=YYYYYYYYYY              # developer.apple.com -> Membership -> Team ID
TELEGRAM_BOT_TOKEN=                 # optional legacy channel; from @BotFather
EA_WEB_TOKEN=                       # openssl rand -hex 32 ; used by the iPhone Shortcut and web chat
EA_BRIDGE_TOKEN=                    # server deployment: written by bridge/install_bridge.sh; the server gets the same value
# Server deployment only, and only in data/server.env (never here): CLAUDE_CODE_OAUTH_TOKEN=  from `claude setup-token`
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
OPENAI_API_KEY=                     # optional, for transcribing Telegram voice notes
DEEPGRAM_API_KEY=                   # alternative transcription provider
OPENAI_COMPAT_API_KEY=              # only if your local model server wants one
# Food ordering (Mac only): text the checkout page's delivery address must contain, e.g. the street number and name. Empty = no check.
FOOD_ADDRESS_CONTAINS=
